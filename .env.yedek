# Codifya Karar Motoru — örnek yapılandırma
# Kopyala: cp .env.example .env   (.env commit EDİLMEZ)

ORTAM=gelistirme

# ⚠️ shadow modda ölçülmüş doğruluk raporu olmadan threshold'a GEÇİLMEZ.
# shadow | advisory | threshold | off
AUTONOMY_LEVEL=shadow

# Eşikler (Faz 1 B1.4'te policy tablosuna taşınacak)
ESIK_OTO_UYGULA_TUTAR_TL=5000
ESIK_OTO_UYGULA_MIN_GUVEN=0.85

# LLM — 5. TUR CANLIDA (2026-08-08).
#
# Router: tam dogruluk 36/48 (%75,0) — dort modelin en iyisi.
#         gecelik_ozet 1/10 -> 5/10 -> 7/10, taban seviyesine geri dondu.
# Gerekce: 20/20 kabul.
#
# ⚠️ 4. ve 5. tur once "gerekce tarafini bozuyor" diye geri alinmisti (11/20,
# 7/20). Sebep model degil, EGITIM/CALISMA ZAMANI BICIM UYUSMAZLIGI idi:
# egitim hedefi duz metin, calisma zamani ise JSON semasi dayatiyordu.
# Sema egitilmis kipte kaldirildi (app/llm/explain.py::llm_ureteci) ve
# ucu de 20/20'ye cikti. Ayrinti: dokumantasyon/OLCUMLER.md.

OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_ADI=codifya-router:tur5
LLM_ISTEM_BICIMI=egitilmis
LLM_TIMEOUT_SN=60

# Gecelik işte kaç karar için gerekçe üretilsin (CPU bütçesi)
GECELIK_GEREKCE_UST_N=25
