# Codifya Karar Motoru — örnek yapılandırma
# Kopyala: cp .env.example .env   (.env commit EDİLMEZ)

ORTAM=gelistirme

# ⚠️ shadow modda ölçülmüş doğruluk raporu olmadan threshold'a GEÇİLMEZ.
# shadow | advisory | threshold | off
AUTONOMY_LEVEL=shadow

# Eşikler (Faz 1 B1.4'te policy tablosuna taşınacak)
ESIK_OTO_UYGULA_TUTAR_TL=5000
ESIK_OTO_UYGULA_MIN_GUVEN=0.85

# LLM — Faz 2 B2.1'de qwen2.5:1.5b-instruct çekilecek
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_ADI=qwen2.5:1.5b-instruct
LLM_TIMEOUT_SN=60

# Gecelik işte kaç karar için gerekçe üretilsin (CPU bütçesi)
GECELIK_GEREKCE_UST_N=25
