# Codifya — kurulum ayarları şablonu.
#
#     cp .env.ornek .env
#
# ⚠️ Bu dosya İŞ parametrelerini taşımaz. Ölü stok eşiği, finansman oranı
# gibi sayılar profiller/*.json içinde (bkz. app/core/isletme_profili.py).

# --- Ortam ---
# uretim | gelistirme. ⚠️ `uretim` iken API_ANAHTARLARI boşsa servis AÇILMAZ.
ORTAM=uretim

# --- Kimlik doğrulama ---
# Biçim: anahtar | anahtar:kullanici | anahtar:kullanici:rol
# ⚠️ Anahtarın İÇİNDE ':' OLMAMALI — ayraç olduğu için anahtar kırpılır.
#    Üretimde en az 16 karakter zorunlu, kısa olursa servis açılmaz.
API_ANAHTARLARI=erp-sistemi-icin-uzun-bir-anahtar:erp:sistem,operator-anahtari-uzun:esmanur:yonetici

# TLS arkasındaysa true. Şemadan da tespit ediliyor ama açıkça yazmak iyi.
CEREZ_GUVENLI=true

# Bu tutarın üstünü yalnızca `yonetici` rolü onaylayabilir. 0 = kısıt yok.
ONAY_YONETICI_ESIGI_TL=0

# Anahtar başına dakikalık istek sınırı. 0 = sınır yok.
HIZ_SINIRI_DAKIKADA=300

# --- Otonomi ---
# ⚠️ shadow | advisory | threshold | off
# Gerçek veride ölçülmüş doğruluk raporu OLMADAN threshold'a GEÇİLMEZ.
AUTONOMY_LEVEL=shadow

# --- İşletme profili ---
# Müşteriye özel iş parametreleri. Boşsa varsayılan kullanılır.
ISLETME_PROFILI_YOLU=profiller/varsayilan.json

# --- LLM ---
LLM_MODEL_ADI=codifya-router:tur6
LLM_ISTEM_BICIMI=egitilmis
